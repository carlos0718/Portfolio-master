{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/github.js": {
      "maxDuration": 15
    },
    "api/cv.js": {
      "maxDuration": 15
    },
    "api/certificates.js": {
      "maxDuration": 15
    },
    "api/admin/upload.js": {
      "maxDuration": 25
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|projects/|certificates/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
