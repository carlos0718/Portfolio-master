# ==========================================
# Server-side Environment Variables (Vercel)
# NEVER prefix secrets with VITE_ or REACT_APP_
# ==========================================

# AWS S3 Configuration (server-side only via /api/cv, /api/certificates, /api/admin/upload)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_private_bucket_name

# GitHub Configuration (server-side only via /api/github)
GITHUB_USERNAME=carlos0718
GITHUB_TOKEN=your_github_personal_access_token_here

# Gemini AI Configuration (for AI Assistant via /api/chat)
# Create a Free Tier or billed key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to cascade: gemini-2.5-flash-lite -> gemini-2.5-flash -> gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Protected Admin Vault secret (min 8 chars) for uploading CVs & Certificates at /admin/vault
ADMIN_UPLOAD_SECRET=change_this_to_a_strong_secret_password

# Google Calendar OAuth2 (server-side only via /api/availability, /api/book, /api/chat)
# Generate GOOGLE_REFRESH_TOKEN locally with: npm run calendar:auth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
# Optional overrides:
# GOOGLE_CALENDAR_ID=primary
# CALENDAR_BUFFER_MINUTES=15
# CALENDAR_BLOCK_KEYWORDS=extra1,extra2

# Resend Email OTP Verification (optional — activates 6-digit email verification before booking)
# Requires a verified domain in Resend (e.g. mentoria-dev.tech)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Carlos Jesús <agenda@mentoria-dev.tech>
